# APPLICATION

APP_PUBLIC_URL=http://localhost:8080
APP_STORAGE_PATH=generated
LIBREOFFICE_PATH=C:\\Program Files\\LibreOffice\\program\\soffice.exe

# Optional first admin account. Set a private password (6+ characters); never commit .env.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=Administrator
ADMIN_BOOTSTRAP_PASSWORD=


# DATABASE

DATABASE_URL=jdbc:postgresql://localhost:5432/projectbook
DATABASE_USERNAME=projectbook
DATABASE_PASSWORD=123456


# GOOGLE OAUTH

GOOGLE_AUTH_ENABLED=false
JWT_SECRET=replace-with-a-long-random-jwt-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret


# PASSWORD RESET

# Disabled by default. Enable only after SMTP is configured.
PASSWORD_RESET_ENABLED=false

# EMAIL / PASSWORD RESET

SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_TEST_CONNECTION=false


# EMBEDDING / LEGACY AI FALLBACK

AI_PROVIDER=ollama
AI_API_KEY=
AI_CHAT_MODEL=qwen3:8b
AI_EMBEDDING_MODEL=bge-m3
AI_BASE_URL=http://localhost:11434
AI_EMBEDDING_BASE_URL=http://localhost:11434
# Testing-only: keep invalid drafts with a visible marker after two repair attempts.
ALLOW_INVALIDATED_SECTIONS=false


# LLM PROVIDER 1

# Supported: ollama, openai, gemini, huggingface
# Leave LLM_PROVIDER_1 empty to disable this slot.
# Structured output: auto (native for supported providers, schema-in-prompt otherwise),
# native (force provider JSON-schema support), or prompt (always use schema-in-prompt).

LLM_PROVIDER_1=ollama
LLM_PROVIDER_1_NAME=ollama-local
LLM_MODEL_1=qwen3:8b
LLM_BASE_URL_1=http://localhost:11434
LLM_API_KEY_1=
LLM_ENABLED_1=true
LLM_STRUCTURED_OUTPUT_1=auto


# LLM PROVIDER 2

# Supported: ollama, openai, gemini, huggingface
# Leave LLM_PROVIDER_2 empty to disable this slot.

LLM_PROVIDER_2=
LLM_PROVIDER_2_NAME=provider-2
LLM_MODEL_2=
LLM_BASE_URL_2=
LLM_API_KEY_2=
LLM_ENABLED_2=true
LLM_STRUCTURED_OUTPUT_2=auto


# LLM PROVIDER 3

# Supported: ollama, openai, gemini, huggingface
# Leave LLM_PROVIDER_3 empty to disable this slot.

LLM_PROVIDER_3=
LLM_PROVIDER_3_NAME=gemini
LLM_MODEL_3=
LLM_BASE_URL_3=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY_3=
LLM_ENABLED_3=true
LLM_STRUCTURED_OUTPUT_3=auto


# LLM PROVIDER 4

# Supported: ollama, openai, gemini, huggingface
# Leave LLM_PROVIDER_4 empty to disable this slot.

LLM_PROVIDER_4=
LLM_PROVIDER_4_NAME=huggingface
LLM_MODEL_4=
LLM_BASE_URL_4=https://router.huggingface.co/v1
LLM_API_KEY_4=
LLM_ENABLED_4=true
LLM_STRUCTURED_OUTPUT_4=auto


# LLM WORKER POOL

LLM_RETRY_BACKOFF_MS=1500
LLM_PROVIDER_COOLDOWN_MS=10000
LLM_MAX_PROVIDER_ATTEMPTS=3
LLM_CONNECTION_TIMEOUT_MS=15000
LLM_READ_TIMEOUT_MS=180000


# CHROMA VECTOR DATABASE

CHROMA_BASE_URL=http://localhost:8000


# GITHUB

GITHUB_TOKEN=
GITHUB_CLONE_TIMEOUT_SECONDS=300


# JOB RECOVERY

JOB_STALE_THRESHOLD_MINUTES=30
JOB_MAX_RECOVERY_ATTEMPTS=2


# EMAIL / PASSWORD RESET

# Keep empty while password reset email is disabled/not configured.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_TEST_CONNECTION=false
